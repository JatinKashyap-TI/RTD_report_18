<odoo>
    <data noupdate="1" >
                   <!-- Report Header -->

    <record id="vat_return" model="account.report">
        <field name="name">VAT Return</field>
        <field name="active">True</field>
        <field name="country_id" ref="base.ie"/>
        <field name="load_more_limit">0</field>
        <field name="prefix_groups_threshold">4000</field>
        <field name="filter_multi_company">tax_units</field>
        <field name="default_opening_date_filter">previous_month</field> 
        <field name="filter_date_range">True</field>
        <field name="filter_growth_comparison">True</field>
        <field name="filter_period_comparison">True</field>
        <field name="availability_condition">always</field>
        <field name="filter_show_draft">True</field>
        <field name="root_report_id" ref="account.generic_tax_report"/>

    </record>

                    <!-- Report Column -->

    <record id="vat_report_column_balance" model="account.report.column">
        <field name="name">Balance</field>
        <field name="report_id" ref="vat_return"/>
        <field name="expression_label">balance</field>
        <field name="figure_type">monetary</field> 
        <field name="sortable">False</field>
        <field name="blank_if_zero">False</field>
    </record>

    <!-- Line 1  -->

    <record id="vat_report_VAT_on_Sales" model="account.report.line">
        <field name="name">VAT on Sales</field>
        <field name="report_id" ref="vat_return"/>
        <field name="hierarchy_level">1</field>
        <field name="code" >cVOS_R5</field>
        <field name="expression_ids" eval="[
            (0, 0, {
                'label': 'balance',
                'engine': 'tax_tags',
                'formula': 'VOS',
                'date_scope': 'strict_range',
            })
        ]"/>
    </record>

    <!-- Line 2  -->

    <record id="vat_report_VAT_on_Purchases" model="account.report.line">
        <field name="name">VAT on Purchases</field>
        <field name="report_id" ref="vat_return"/>
        <field name="hierarchy_level">1</field>
        <field name="code" >cVOP_R5</field>
        <field name="expression_ids" eval="[
            (0, 0, {
                'label': 'balance',
                'engine': 'tax_tags',
                'formula': 'VOP',
                'date_scope': 'strict_range',
            })
        ]"/>
    </record>

    <record id="vat_report_Net_Payable_Repayable" model="account.report.line">
        <field name="name">Net Payable/Repayable</field>
        <field name="report_id" ref="vat_return"/>
        <field name="hierarchy_level">1</field>
        <!-- <field name="code" ></field> -->
        <field name="expression_ids" eval="[
            (0, 0, {
                'label': 'balance',
                'engine': 'aggregation',
                'formula': 'cVOS_R5.balance-cVOP_R5.balance',
                'date_scope': 'strict_range',
            })
        ]"/>
    </record>
    <record id="vat_report_Total_Goods_TO_other_EU_countries" model="account.report.line">
        <field name="name">Total Goods TO other EU countries</field>
        <field name="report_id" ref="vat_return"/>
        <field name="hierarchy_level">1</field>
        <field name="code" >cE1</field>
        <field name="expression_ids" eval="[
            (0, 0, {
                'label': 'balance',
                'engine': 'tax_tags',
                'formula': 'E1',
                'date_scope': 'strict_range',
            })
        ]"/>
    </record>
    <record id="vat_report_Total_Goods_FROm_other_EU_countries" model="account.report.line">
