                'date_scope': 'strict_range',
            })
        ]"/>
    </record>
    <record id="vat_report_Total_Services_TO_other_EU_countries" model="account.report.line">
        <field name="name">Total Services TO other EU countries</field>
        <field name="report_id" ref="vat_return"/>
        <field name="hierarchy_level">1</field>
